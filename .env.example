# ===== UPSGlam · variables de entorno (copiar a .env y completar; NUNCA subir .env) =====
# --- Supabase (Settings > API) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=<anon-key-publica>
SUPABASE_SERVICE_ROLE_KEY=<solo-backend-nunca-en-la-apk>
SUPABASE_JWT_SECRET=<si-el-proyecto-usa-HS256>
SUPABASE_DB_URL=r2dbc:postgresql://<host>:6543/postgres
SUPABASE_DB_USER=postgres.<ref>
SUPABASE_DB_PASSWORD=<password>

# --- Servicio GPU ---
GPU_SERVICE_URL=http://gpu-service:8000
GPU_QUEUE_CAPACITY=16
GPU_MAX_IMAGE_MB=10
GPU_MAX_SIDE_PX=4096
CUDA_DEVICE=0

# --- Backend ---
BACKEND_PORT=8080
